# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# (.env.local ถูก gitignore ไว้ ไม่ถูก commit)

# ── ค่าที่เปิดเผยได้ (ส่งไป browser) ────────────────────────────
# หยิบจาก Supabase → Project Settings → Data API (URL) และ API Keys (publishable)
# ตั้งใจไม่ฝังค่าจริงไว้ที่นี่ — ก่อนหน้านี้ฝังไว้ แล้วพอย้าย region ค่าก็ค้างชี้
# โปรเจกต์เก่าอยู่เงียบๆ คนตั้งเครื่องใหม่จะต่อผิดฐานโดยไม่มีอะไรเตือน
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── ค่าลับ (ฝั่งเซิร์ฟเวอร์เท่านั้น) ─────────────────────────────
# service_role key bypass RLS ทั้งหมด — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด
# ใช้เฉพาะใน server action / route handler ปล่อยว่างไว้ถ้ายังไม่ใช้
# SUPABASE_SERVICE_ROLE_KEY=
